---
import ThemeSelect from "./ThemeSelect.astro";
import BlueskyIcon from "./icons/BlueskyIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import MastodonIcon from "./icons/MastodonIcon.astro";
import XIcon from "./icons/XIcon.astro";
const today = new Date();

import { SITE_URL, SITE_AUTHOR, SITE_AUTHOR_BIO } from "../consts";
---

<footer class="self-end px-6 pb-12 text-center md:col-start-1 md:row-start-3">
  <ul class="flex items-center justify-center gap-5 mb-4">
    <li>
      <a
        href="https://github.com/kaishin"
        rel="me"
        aria-label="GitHub"
        class="block text-stone-400 transition-colors hover:text-[var(--accent-link)] dark:text-[var(--muted-text)] dark:hover:text-[var(--accent-link)]"
      >
        <GitHubIcon width={20} height={20} />
      </a>
    </li>
    <li>
      <a
        href="https://mastodon.social/@redalemeden"
        rel="me"
        aria-label="Mastodon"
        class="block text-stone-400 transition-colors hover:text-[var(--accent-link)] dark:text-[var(--muted-text)] dark:hover:text-[var(--accent-link)]"
      >
        <MastodonIcon width={20} height={20} />
      </a>
    </li>
    <li>
      <a
        href="https://x.com/kaishin"
        aria-label="X"
        class="block text-stone-400 transition-colors hover:text-[var(--accent-link)] dark:text-[var(--muted-text)] dark:hover:text-[var(--accent-link)]"
      >
        <XIcon width={20} height={20} />
      </a>
    </li>
    <li>
      <a
        href="https://bsky.app/profile/kaishinlab.bsky.social"
        aria-label="Bluesky"
        class="block text-stone-400 transition-colors hover:text-[var(--accent-link)] dark:text-[var(--muted-text)] dark:hover:text-[var(--accent-link)]"
      >
        <BlueskyIcon width={20} height={20} />
      </a>
    </li>
  </ul>
  <div class="h-card hidden">
    <a class="p-name u-url" href={SITE_URL}>
      {SITE_AUTHOR}
    </a>
    <img
      class="u-photo"
      src={SITE_URL + "/logo-bg.jpg"}
      alt={SITE_AUTHOR}
    />
    <p class="p-note">{SITE_AUTHOR_BIO}</p>
  </div>
  <span class="block pb-6 text-stone-400 dark:text-[var(--muted-text)]">
    <em>&copy;</em> 2009-{today.getFullYear()} Reda Lemeden
  </span>

  <ThemeSelect />
</footer>
