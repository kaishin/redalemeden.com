---
import ProjectCard from "@components/ProjectCard.astro";

const projects = [
  {
    name: "Generative AI and Algorithmic Manipulation",
    description:
      "A conference at KTH on how generative AI shapes attention and choice.",
    image: "gen-manip.jpg",
    alt: "Generative AI and Algorithmic Manipulation, 28–29 January 2027, KTH, Stockholm",
    url: "https://gen-manipulation-conf.com",
    state: "upcoming",
    year: "2027",
  },
  {
    name: "Four Rays",
    description:
      "An indie solopreneurship focusing on native app development and design.",
    image: "4rays.jpg",
    url: "https://4rays.net",
    state: "complete",
    year: "2020",
  },
  {
    name: "Swift & Fika",
    description:
      "The first Swift conference in the nordics with over 200 attendees.",
    image: "swift-fika.jpg",
    url: "https://2018.swiftandfika.com",
    state: "paused",
    year: "2018",
  },
];
---

<ul class="not-prose grid-cols-projects grid list-none gap-4 px-0">
  {projects.map((project) => (
    <li class="list-display">
      <ProjectCard {...project} />
    </li>
  ))}
</ul>
