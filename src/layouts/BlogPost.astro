---
import type { CollectionEntry } from "astro:content";
import NavigationLayout from "@layouts/NavigationLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_AUTHOR, SITE_URL } from "@consts";

type Props =
  | CollectionEntry<"blog">["data"]
  | CollectionEntry<"derived-data">["data"]
  | CollectionEntry<"neosamurai">["data"];

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  isArchived,
  audience,
} = Astro.props;
const assumedAudience = audience?.trim();
const audienceLine = assumedAudience
  ? `Assumed audience: ${assumedAudience}${/[.!?]$/.test(assumedAudience) ? "" : "."}`
  : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rawImage = (image ?? "").trim();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  ...(description ? { description } : {}),
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: SITE_URL,
  },
  url: canonicalURL.href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  image: new URL(
    rawImage === "" ? "/social-cards/default.jpg" : rawImage,
    Astro.site,
  ).href,
};
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<NavigationLayout
  title={title}
  description={description}
  image={image}
  isPost
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <Fragment slot="head">
    <slot name="head" />
    <script type="application/ld+json" set:html={structuredDataJson}></script>
  </Fragment>
  <div class="title">
    <div class="date">
      <FormattedDate date={pubDate} />
      {updatedDate && (
        <div class="last-updated-on">
          Last updated on <FormattedDate date={updatedDate} />
        </div>
      )}
    </div>
    <h1>{title}</h1>
    <div class="my-6 h-px bg-(--border-soft)"></div>
  </div>
  {audienceLine && (
    <>
      <p class="not-prose mb-6 text-sm text-[var(--muted-text)]">
        {audienceLine}
      </p>
      <div class="my-6 h-px bg-(--border-soft)"></div>
    </>
  )}
  {isArchived && (
    <aside
      aria-label="Archived post"
      class="not-prose mb-10 flex items-start gap-3.5 rounded-2xl border border-(--archive-border) bg-(--archive-bg) px-5 py-4"
    >
      <svg
        aria-hidden="true"
        class="mt-0.5 size-4 shrink-0 text-(--archive-label)"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="20" height="5" x="2" y="3" rx="1"></rect>
        <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path>
        <path d="M10 12h4"></path>
      </svg>
      <div>
        <p class="text-xs font-semibold tracking-[0.14em] text-(--archive-label) uppercase">
          Archived
          <span aria-hidden="true" class="mx-1">
            ·
          </span>
          <span class="tabular-nums">{pubDate.getFullYear()}</span>
        </p>
        <p class="mt-1 text-sm/6 text-pretty text-(--archive-text)">
          This post is archived. Some details may no longer be accurate.
        </p>
      </div>
    </aside>
  )}
  <slot />
</NavigationLayout>
