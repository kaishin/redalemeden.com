---
import type { CollectionEntry } from "astro:content";
import NavigationLayout from "@layouts/NavigationLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_AUTHOR, SITE_URL } from "@consts";

type Props =
  CollectionEntry<"blog">["data"] | CollectionEntry<"derived-data">["data"];

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  isArchived,
  audience,
} = Astro.props;
const assumedAudience = audience?.trim();
const audienceLine = assumedAudience
  ? `Assumed audience: ${assumedAudience}${/[.!?]$/.test(assumedAudience) ? "" : "."}`
  : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rawImage = (image ?? "").trim();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  ...(description ? { description } : {}),
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: SITE_URL,
  },
  url: canonicalURL.href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  image: new URL(
    rawImage === "" ? "/social-cards/default.jpg" : rawImage,
    Astro.site,
  ).href,
};
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<NavigationLayout
  title={title}
  description={description}
  image={image}
  isPost
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <Fragment slot="head">
    <slot name="head" />
    <script type="application/ld+json" set:html={structuredDataJson}></script>
  </Fragment>
  <div class="title">
    <div class="date">
      <FormattedDate date={pubDate} />
      {updatedDate && (
        <div class="last-updated-on">
          Last updated on <FormattedDate date={updatedDate} />
        </div>
      )}
    </div>
    <h1>{title}</h1>
    <div class="my-6 h-px bg-(--border-soft)"></div>
  </div>
  {audienceLine && (
    <>
      <p class="not-prose mb-6 text-sm text-[var(--muted-text)]">
        {audienceLine}
      </p>
      <div class="my-6 h-px bg-(--border-soft)"></div>
    </>
  )}
  {isArchived && (
    <div class="mb-8 rounded-2xl border border-yellow-300 bg-yellow-100/80 px-5 py-4 dark:border-yellow-500/35 dark:bg-yellow-500/10">
      <p class="text-sm font-medium text-yellow-900 dark:text-yellow-100">
        This post has been <strong>archived</strong>. Some or all of the
        information below may no longer be relevant or correct.
      </p>
    </div>
  )}
  <slot />
</NavigationLayout>
