---
import { isPublished } from "@lib/published";
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "@layouts/BlogPost.astro";
import { excerpt } from "@lib/excerpt";
import { type PostLink, withNeighbors } from "@lib/adjacent";

export async function getStaticPaths() {
  const posts = await getCollection("derived-data", isPublished);

  return withNeighbors(posts, "/derived-data").map(
    ({ post, previous, next }) => ({
      params: { slug: post.id },
      props: { post, previous, next },
    }),
  );
}

interface Props {
  post: CollectionEntry<"derived-data">;
  previous?: PostLink;
  next?: PostLink;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  {...post.data}
  description={post.data.description ?? (excerpt(post.body ?? "") || undefined)}
  previous={previous}
  next={next}
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Derived Data RSS"
      href="/derived-data-feed.xml"
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Derived Data JSON Feed"
      href="/derived-data-feed.json"
    />
  </Fragment>
  <Content />
</BlogPost>
