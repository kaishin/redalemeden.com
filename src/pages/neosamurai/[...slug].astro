---
import { isPublished } from "@lib/published";
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "@layouts/BlogPost.astro";
import { excerpt } from "@lib/excerpt";
import { type PostLink, withNeighbors } from "@lib/adjacent";

export async function getStaticPaths() {
  const posts = await getCollection("neosamurai", isPublished);

  return withNeighbors(posts, "/neosamurai").map(
    ({ post, previous, next }) => ({
      params: { slug: post.id },
      props: { post, previous, next },
    }),
  );
}

interface Props {
  post: CollectionEntry<"neosamurai">;
  previous?: PostLink;
  next?: PostLink;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  {...post.data}
  description={post.data.description ?? (excerpt(post.body ?? "") || undefined)}
  previous={previous}
  next={next}
>
  <Content />
</BlogPost>
